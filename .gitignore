target/
*.log

# Tool state redirected into the project.
/.docker/
.envrc.local

# XDG_DATA_HOME. nix writes its trusted-settings answer here, and insists on
# reading the file before it will evaluate any flake declaring nixConfig, so a
# sandbox that denies $HOME needs this pointed inside the project (M4b).
/.local/

# XDG_CONFIG_HOME. Deny by default, because the redirect is a blanket: every
# program run from the environment lands here, not just the ones this repository
# knows about. An earlier allow-by-default rule collected a GUI editor's caches
# and local storage on the first developer to open one from the project shell.
# Anything this repository genuinely commits gets its own negation below.
/.config/

# Agent state, one directory per agent, written inside the project so that it
# belongs to this project and no other.
/.agents/

/prompts.md

# direnv
.direnv

# pre-commit
.pre-commit-config.yaml
