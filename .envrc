# The only thing here that reaches outside the checkout, kept because a parent
# .envrc above the repo is a personal, machine-level concern.
source_up_if_exists

# Bootstrap, and the one exception to "env vars live in flake.nix". These two
# have to be exported before `use flake`, because nix itself needs them to read
# the flake at all. Keep the values identical to flake.nix's;
# check_bootstrap_mirror resolves both files and fails if they drift.
export TMPDIR="$PWD/.tmp"
export XDG_CACHE_HOME="$PWD/.cache"
mkdir -p "$TMPDIR" "$XDG_CACHE_HOME"

# Every other config path lives in flake.nix's shellHook, which direnv reaches
# because `use_flake` evals the whole of `nix print-dev-env`, whose last line is
# `eval "$shellHook"`.
if [[ -f "flake.nix" ]] && command -v nix &>/dev/null; then
    use flake .
fi

# After the flake on purpose, so a personal override actually wins.
source_env_if_exists .envrc.local
